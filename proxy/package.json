{
  "name": "marc-coach-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that holds the Anthropic key and turns M/ARC coach reports into plain-English explanations",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && vitest run",
    "test": "vitest run",
    "dev": "npx wrangler@4 dev",
    "deploy": "npx wrangler@4 deploy",
    "secret": "npx wrangler@4 secret put ANTHROPIC_API_KEY",
    "dry-run": "npx wrangler@4 deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
