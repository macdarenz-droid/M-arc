<div class="container">
  <text class="head">{{ head }}</text>
  <text class="row">{{ r0 }}</text>
  <text class="row">{{ r1 }}</text>
  <text class="row">{{ r2 }}</text>
  <text class="row">{{ r3 }}</text>
  <text class="row">{{ r4 }}</text>
  <text class="row">{{ r5 }}</text>
  <text class="row">{{ r6 }}</text>
  <text class="row">{{ r7 }}</text>
  <text class="row">{{ r8 }}</text>
  <text class="row">{{ r9 }}</text>
  <text class="tally">{{ tally }}</text>
  <div class="bar">
    <input type="button" class="btn" value="Send" onclick="onSend"></input>
    <input type="button" class="btn" value="Setup" onclick="onSetup"></input>
  </div>
</div>
